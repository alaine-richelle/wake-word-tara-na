# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# --- Raw / generated audio & data (large, not version-controlled) ---
data/**/*.wav
data/positive/
data/negative/
data/noise/
data/silence/
data/features.npz
*.npz

# --- Model artifacts ---
# Keep the single canonical model.pkl (small, ~0.1 MB) but ignore any other
# checkpoints that might be produced during experimentation.
*.pt
*.pth
*.ckpt
*_checkpoint*.pkl
checkpoints/

# --- Logs (generated, not committed) ---
logs/*
!logs/.gitkeep
*.log

# --- Results: keep the small analysis artifacts, ignore bulky extras ---
results/*.png
!results/confusion_matrix_test.png
!results/confusion_matrix_val.png
results/*.jsonl

# --- User recordings (never commit personal audio) ---
user_recordings/

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp
