{
  "wake_phrase": "tara na",
  "seed": 0,

  "dataset": {
    "data_dir": "data",
    "n_speakers_total": 100,
    "train_speakers": 80,
    "val_speakers": 10,
    "test_speakers": 10,
    "positives_per_speaker": 6,
    "negatives_per_speaker": 10,
    "noise_clips": 200,
    "silence_clips": 120,
    "speeds": [110, 130, 150, 170, 190],
    "base_pitch": 55,
    "pitch_jitter": 12
  },

  "features": {
    "sr": 16000,
    "n_mels": 40,
    "n_fft": 512,
    "hop": 160,
    "fmin": 20,
    "fmax": 8000,
    "t_frames": 128,
    "db_range": 80.0
  },

  "augmentation": {
    "time_shift": true,
    "noise": true,
    "gain": true,
    "time_stretch": true,
    "pitch_shift": true,
    "word_break": true,
    "time_shift_frac": 0.15,
    "noise_db_range": [-30.0, -12.0],
    "gain_db_range": [-6.0, 4.0],
    "stretch_range": [0.85, 1.15],
    "pitch_semi_range": [-2.0, 2.0],
    "break_prob": 0.35,
    "break_ms_range": [80, 220]
  },

  "model": {
    "n_mels": 40,
    "t_frames": 128,
    "in_channels": 1,
    "widths": [32, 64, 128],
    "kernel": 5,
    "stride": 1,
    "pool": 2,
    "hidden": 64,
    "dropout": 0.3,
    "num_classes": 2
  },

  "training": {
    "epochs": 12,
    "batch_size": 128,
    "lr": 0.001,
    "weight_decay": 1e-4,
    "optimizer": "adam",
    "early_stopping_patience": 4,
    "pos_weight": 1.0,
    "device": "cpu"
  },

  "evaluation": {
    "thresholds": [0.3, 0.4, 0.5, 0.6, 0.7, 0.8, 0.9],
    "min_recall_for_threshold": 0.95,
    "default_threshold": 0.5
  }
}
